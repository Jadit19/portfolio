{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Adit Jain's portfolio: an isometric motorcycle game.",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./index.html",
    "build": "bun run scripts/build.ts",
    "preview": "bun run scripts/preview.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "7.0.2"
  }
}
